# grass-and-water.tile
#
# Top half: grass meadow at ground level (5 mm).
# Bottom half: flat water pool (3 mm) — blue placeholder surface.
# Transition: organic shoreline with a 5 mm dirt slope between the two levels.
#
# Note: the slope in the shoreline strip is bare soil rendered vertically
# (z-offsets from the sloped base).  Future work will need slope-normal
# orientation for features placed on non-horizontal surfaces.

surface:
  seed: 99

regions:
  meadow:
    contains: [0.5, 0.75]      # centre of top half
    layers:
      - type: grass
        groups_per_square: 240

  pool:
    contains: [0.5, 0.25]      # centre of bottom half
    height_mm: 3.0
    layers:
      - type: water

boundaries:
  shoreline:
    from: {edge: left,  t: 0.48}
    to:   {edge: right, t: 0.52}
    path: organic
    amplitude_mm: 3.0
    wavelength_mm: 12.0
    width_mm: 5.0               # dirt transition strip width
    layer: {type: soil}
