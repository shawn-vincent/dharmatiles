# grass-and-water.tile
#
# Top half: grass meadow at ground level (5 mm).
# Bottom half: flat water pool (3 mm) — blue placeholder surface.
# Transition: organic shoreline with a 5 mm dirt slope between the two levels.
#
# Note: the slope in the shoreline strip is bare soil rendered vertically
# (z-offsets from the sloped base).  Future work will need slope-normal
# orientation for features placed on non-horizontal surfaces.

surface:
  sizes: [1x1]
  seed: 97

regions:
  meadow:
    contains: [0.5, 0.75]      # centre of top half
    layers:
      - type: grass
        groups_per_square: 240

  pool:
    contains: [0.5, 0.25]      # centre of bottom half
    height_mm: 3.0
    layers:
      - type: water
      - type: rocks
        stones_per_square: 2    # → 2 large boulders in the pool (0–3 visible)
        r_min: 3.0              # mm — minimum horizontal semi-axis
        r_max: 5.0              # mm — maximum horizontal semi-axis
        flat_min: 2.0           # height = flat × mean_r → min ≈ 8 mm body
        flat_max: 2.8           # max ≈ 11 mm body; tops well above water line
        size_power: 1.0         # uniform draw — all rocks are large
        n_cuts: 3               # fewer cuts → rounder, boulder-like silhouette

boundaries:
  shoreline:
    from: {edge: left,  t: 0.48}
    to:   {edge: right, t: 0.52}
    path: organic
    amplitude_mm: 5.0
    wavelength_mm: 12.0
    width_mm: 2.5               # dirt transition strip width
    layers:
      - type: soil
      - type: rocks
        stones_per_square: 60
        r_min: 0.8
        r_max: 2.2
        size_power: 1.5
