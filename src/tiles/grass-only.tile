# grass-only.tile
#
# One full 1x1 grass region. No soil layer, so the ground is flat.

surface:
  sizes: [1x1]
  seed: 123

regions:
  meadow:
    contains: [0.5, 0.5]
    layers:
      - type: grass
        groups_per_square: 80
        group_min: 1
        group_max: 1
        group_dir_jitter: 0.14
        blade_width_min: 0.75
        blade_width_max: 2.0
        blade_length_min: 8
        blade_length_max: 14
        blade_segment_length: 0.8
        curl_min: 0.3
        curl_max: 0.8
        rise_cap: 2.0
