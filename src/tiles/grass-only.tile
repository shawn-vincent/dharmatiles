# grass-only.tile
#
# One full 1x1 grass region. No soil layer, so the ground is flat.

surface:
  sizes: [1x1]
  seed: 1

regions:
  meadow:
    contains: [0.5, 0.5]
    layers:
      - type: grass
        groups_per_square: 5
        group_min: 1
        group_max: 1
        group_dir_jitter: 0.14
        blade_width_min: 2.0
        blade_width_max: 3.0
        blade_length_min: 40
        blade_length_max: 40
        blade_segment_length: 0.8
        blade_curl_min: 0.3
        blade_curl_max: 0.8
        blade_smooth: 0
        blade_rise_cap: 2.0
        blade_clearance: 0.5
        blade_top_facets: 4
        blade_thickness: 0.2
        keel_fraction: 0.6
