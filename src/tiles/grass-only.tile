# grass-only.tile
#
# One full 1x1 grass region. No soil layer, so the ground is flat.

surface:
  sizes: [1x1]
  seed: 123

regions:
  meadow:
    contains: [0.5, 0.5]
    layers:
      - type: grass
        groups_per_square: 10
        group_min: 20
        group_max: 30
        group_dir_jitter: 0.14
        blade_width_min: 0.75
        blade_width_max: 2.0
        blade_length_min: 8
        blade_length_max: 14
        blade_segment_length: 0.8
        blade_curl_min: 0.3
        blade_curl_max: 0.8
        blade_smooth: 1.0
        rise_cap: 2.0
        n_top_facets: 2
        thickness: 0.3
        keel_fraction: 0.6
