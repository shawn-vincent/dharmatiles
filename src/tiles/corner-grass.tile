# corner-grass.tile
#
# A patch of grass in the bottom-left corner; the rest is bare soil.
# Works as a transition tile where a meadow ends at a path corner.
#
# NOTE: Was originally written in TOML format (unsupported by YAML loader).
# Converted to YAML on 2026-06-03.

surface:
  cols: 1
  rows: 1
  seed: 99

regions:
  patch:
    contains: [0.15, 0.15]
    layers:
      - type: grass
        groups_per_square: 240

  floor:
    contains: [0.75, 0.75]
    layers:
      - type: soil

boundaries:
  corner-cut:
    from: {edge: left,   t: 0.5}
    to:   {edge: bottom, t: 0.5}
    path: organic
    amplitude_mm: 2.5
    wavelength_mm: 8.0
    # no layers — both regions are at the same elevation,
    # so no slope needed; the organic path alone makes the edge look real
