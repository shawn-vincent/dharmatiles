# coast-left.tile
#
# Grass on the left half, water on the right.
# The boundary has a 4 mm soil ramp that bridges the 2 mm elevation
# difference (grass at 5 mm, water at 3 mm).
#
# NOTE: water rendering requires Phase 2.  This spec is valid and will
# load without errors, but the water region will render as bare soil
# at the wrong elevation until WaterLayer is implemented.

surface:
  seed: 7

regions:
  meadow:
    contains: [0.25, 0.5]
    # height_mm: 5.0  ← grass default
    layers:
      - type: grass
        groups_per_square: 240
      - type: grass         # sparse tall blades scattered through the meadow
        groups_per_square: 30
        blade_width_min: 1.3
        blade_width_max: 1.7
        blade_length_min: 14.4
        blade_length_max: 14.4

  lake:
    contains: [0.75, 0.5]
    # height_mm: 3.0  ← water default (2 mm below ground)
    layers:
      - type: water

boundaries:
  shoreline:
    from: {edge: top,    t: 0.55}
    to:   {edge: bottom, t: 0.45}
    path: organic
    amplitude_mm: 4.0
    wavelength_mm: 12.0
    width_mm: 4.0           # strip width; slope interpolates 5 mm → 3 mm
    layer:
      type: soil             # bare ramp, no seeds
