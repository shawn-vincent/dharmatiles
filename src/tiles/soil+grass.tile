# soil+grass.tile
#
# Left half: grass.  Right half: bare soil.
# The organic boundary creates a natural meadow margin.
#
# Grass region:  grass_underlay (embossed 2D texture) + grass (3D blades).
# Soil region:   soil (blob texture), masked to this region only.
# Boundary:      zero-width (same elevation both sides — no slope needed).

surface:
  seed: 42

regions:
  meadow:
    contains: [0.25, 0.5]
    # height_mm: 5.0  ← grass default; no need to write it
    layers:
      - type: grass_underlay
        groups_per_square: 240   # match companion grass layer
      - type: grass
        groups_per_square: 24

  dirt:
    contains: [0.75, 0.5]
    layers:
      - type: soil   # masked to the dirt region only

boundaries:
  margin:
    from: {edge: top,    t: 0.48}
    to:   {edge: bottom, t: 0.52}
    path: organic
    amplitude_mm: 5
    wavelength_mm: 10.0
    # width_mm defaults to 0 → zero-width dividing line, no layer
