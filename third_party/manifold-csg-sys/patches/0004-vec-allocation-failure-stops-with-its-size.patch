 namespace manifold {
 
+// Defined by the program (manifold-csg-sys): reports that an allocation of
+// `bytes` failed, and stops. It does not return.
+extern "C" [[noreturn]] void manifold_alloc_failed(size_t bytes);
+
+// `malloc` for `n` elements of `T`, never null: a request too big for
+// size_t, or one the allocator cannot meet, stops with its size. (The
+// ASSERT after each call compiles to nothing without exceptions, so a null
+// was written through: in the browser, a memory fault far from its cause.)
+template <typename T>
+inline T* AllocChecked(size_t n) {
+  if (n > SIZE_MAX / sizeof(T)) manifold_alloc_failed(SIZE_MAX);
+  T* p = reinterpret_cast<T*>(malloc(n * sizeof(T)));
+  if (p == nullptr) manifold_alloc_failed(n * sizeof(T));
+  return p;
+}
+
 struct Empty {};
 
