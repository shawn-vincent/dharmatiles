// The walking skeleton (plan.html, P1): a flat 1×1 tile, bare ground at
// the ground level, on the system's connector (DungeonBlocks for db).
// No region: the whole tile is the default area.

tile flat size="1x1" seed=1 {
    about "Flat ground at 5 mm on one square: the first tile built end to end."
    stack {
        ground          // flat, at the ground level (5 mm)
    }
}
