// A flat 1×1: the walking-skeleton tile (plan.html, P1).
// Bare ground at the ground level on one square.  Like every tile it
// names no base: `dharmatiles build lib:tiles/test/flat-1x1.kdl` builds
// it for DungeonBlocks, the default system, and adds that base.

tile flat size="1x1" {
    stack {
        ground                          // flat, at the ground level (5 mm)
    }
}
