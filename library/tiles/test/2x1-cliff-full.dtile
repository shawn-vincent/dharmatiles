// Every control the cliff vocabulary names (bank, scree, shattered patches,
// ledges): the language tests' fixture.
// A 2×1 cliff run: a band of stacked rock against the north edge, with dirt
// on its top and scree at its foot.

tile size="2x1" seed=1 {
    about """
        Rock band against the north edge. Both ends finish in the
        standard end section, so runs butt end to end.
        """

    let footHeight 4                // rockpile's foot; the library's edge height is 3.4

    region crag { within "[10 .. 20]" of=northEdge }
    region apron { within 6.5 of=crag }

    stack {
        base
        dirt top=footHeight {
            pin top="[dirtEdgeHeight .. dirtEdgeHeight + 3.5]" at=apron
            pin top="dirtEdgeHeight + [1.5 .. 3.5]" at=crag
            scatter per-square=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff top="dirtEdgeHeight + 35" at=crag {
            rock mixed
            stone-size massive
            shattered patches=3 width="5..10"
        }
        dirt top="bottom + [0.6 .. 1.2]" at=crag

        // scree: fallen stones gathered at the cliff's foot
        scatter against=cliff per-square=55 reach=4 { stone size="1..6" mostly=small }
        scatter against=cliff per-square=2.5 { boulder size="4.5..8" }
    }
}
