// Two or three tall stacks on a shared footing.

tile size="1x1" seed=1 {
    about """
        Two or three tall stacks on a shared footing.
        """

    region crag { within 15.5 of="(0.5, 0.5)"; within 12.5 of="(0.2, 0.61)"; within 11.5 of="(0.71, 0.41)" }
    region cragn1r1 { within 12 of="(0.5, 0.5)" }
    region cragn2r1 { within 9.5 of="(0.2, 0.61)" }
    region cragn3r1 { within 9 of="(0.71, 0.41)" }
    region cragn1r2 { within 8 of="(0.5, 0.5)" }
    region cragn2r2 { within 6.5 of="(0.2, 0.61)" }
    region cragn3r2 { within 6 of="(0.71, 0.41)" }
    region cragn1r3 { within 5 of="(0.5, 0.5)" }
    region cragn2r3 { within 4 of="(0.2, 0.61)" }
    region cragn3r3 { within 4 of="(0.71, 0.41)" }
    region apron { within 6.5 of=crag }

    stack {
        base
        dirt top=dirtEdgeHeight {
            pin top="[dirtEdgeHeight .. dirtEdgeHeight + 3.5]" at=apron
            pin top="dirtEdgeHeight + [1.5 .. 3.5]" at=crag
            scatter perSquare=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff top="dirtEdgeHeight + [3 .. 10]" at=crag {
            pin top="dirtEdgeHeight + [4.5 .. 7.5]" at=cragn1r1
            pin top="dirtEdgeHeight + [3 .. 6]" at=cragn2r1
            pin top="dirtEdgeHeight + [3 .. 6]" at=cragn3r1
            pin top="dirtEdgeHeight + [20 .. 23]" at=cragn1r2
            pin top="dirtEdgeHeight + [15.5 .. 18.5]" at=cragn2r2
            pin top="dirtEdgeHeight + [14.5 .. 17.5]" at=cragn3r2
            pin top="dirtEdgeHeight + [52 .. 55]" at=cragn1r3
            pin top="dirtEdgeHeight + [41 .. 44]" at=cragn2r3
            pin top="dirtEdgeHeight + [38.5 .. 41.5]" at=cragn3r3
            rock mixed
            stoneSize massive
        }

        scatter against=cliff perSquare=55 reach=4 { stone size="1..6" mostly=small }
        scatter against=cliff perSquare=2.5 { boulder size="4.5..8" }
    }
}
