// A grass-free cut-stone wall turning the north-west corner of a dirt
// 1×1, ruined and crenellated: exercises corners, battlements, ruin,
// hearting and foot rubble in the golden tests.

tile size="1x1" seed=1 {
    about "A ruined, crenellated cut-stone corner on bare dirt, for golden tests."
    stack {
        base
        dirt
        wall along="north west" style=cut-stone {
            top battlements
            ruin "30%"
        }
    }
}
