// A tall tapering stack.
// Twin of clifflab/rockpile.py's `spire` form at round 17 (31f7c5d), 1x1.

tile cliff-spire-1x1 size="1x1" seed=1 {
    about """
        A tall tapering stack.
        """

    stack {
        dirt level=edge

        cliff form=spire height=58 {
            rock mixed
            stone-size massive
        }
    }
}
