// A wall right round the rim of a dirt 1×1: the golden test for a wall
// meeting the tile edge on all four sides (every corner a quoin).

tile size="1x1" seed=5 {
    about "A fieldstone wall all round the rim on bare dirt, for golden tests."
    stack {
        dirt
        wall along="north east south west" style=fieldstone seed=3 {
            height full
            thickness 6
        }
    }
}
