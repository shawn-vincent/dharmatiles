// A grass-free brick wall along the north edge of a dirt 1×1: the
// parity twin of the Python wall builder (tests/parity/run_lab.py) and a
// golden test tile.  The wall's own seed is the harness's wall seed.

tile wall-brick size="1x1" seed=1 {
    about "A brick wall on bare dirt, for the parity harness and golden tests."
    stack {
        dirt
        wall along="north" style=brick
    }
}
