// The walking skeleton (plan.html, P1): a flat 1×1 tile, bare ground at
// the edge level, on the system's connector (DungeonBlocks for db).  The
// edge level is the lowest the ground may sit, so the tile is a plain
// slab with no rim ramp.
// No region: the whole tile is the default area.

tile flat size="1x1" seed=1 {
    about "Flat ground at the edge level (3.4 mm) on one square: the first tile built end to end."
    stack {
        ground level=edge   // flat, at the edge level (3.4 mm)
    }
}
