tile size="2x2" seed=1 {
    about "Water by a bank, with a rock in it: a test tile."
    line shore wobble=4 {
        through "0.486,0" "0.486,2"
    }
    region bank {
        boundedBy shore
        fill "0.2,1"
    }
    region pool {
        boundedBy shore
        fill "1.5,1"
    }
    region shoreBand { within 7 of=shore }
    stack {
        base
        dirt top=6 {
            pin top="[waterBedHeight .. 6]" at=shoreBand   // anywhere from the bed to the land
            pin top=waterBedHeight at=pool   // the bed, written last so it wins
            stones none
        }
        rock at="1.314,1.086" size=15
        water
    }
}
