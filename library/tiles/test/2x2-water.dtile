tile size="2x2" seed=1 {
    about "Water by a bank, with a rock in it: a test tile."
    line shore wobble=4 {
        through "0.486,0" "0.486,2"
    }
    region bank {
        bounded-by shore
        fill "0.2,1"
    }
    region pool {
        bounded-by shore
        fill "1.5,1"
    }
    stack {
        dirt in=bank level=6 {
            stones none
        }
        ground in=pool level="water - 2.2"
        rock at="1.314,1.086" size=15
        water
    }
}
