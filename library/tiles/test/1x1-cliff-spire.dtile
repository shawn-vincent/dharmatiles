// A tall tapering stack.

tile size="1x1" seed=1 {
    about """
        A tall tapering stack.
        """

    region crag { within 13 of=center }
    region crag2 { within 9.5 of=center }
    region crag3 { within 6.5 of=center }
    region crag4 { within 5 of=center }
    region apron { within 6.5 of=crag }

    stack {
        base
        dirt top=dirtEdgeHeight {
            pin top="[dirtEdgeHeight .. dirtEdgeHeight + 3.5]" at=apron
            pin top="dirtEdgeHeight + [1.5 .. 3.5]" at=crag
            scatter perSquare=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff top="dirtEdgeHeight + [3.5 .. 6.5]" at=crag {
            pin top="dirtEdgeHeight + [16 .. 19]" at=crag2
            pin top="dirtEdgeHeight + [31 .. 34]" at=crag3
            pin top="dirtEdgeHeight + [55 .. 58]" at=crag4
            rock mixed
            stoneSize massive
        }

        scatter against=cliff perSquare=55 reach=4 { stone size="1..6" mostly=small }
        scatter against=cliff perSquare=2.5 { boulder size="4.5..8" }
    }
}
