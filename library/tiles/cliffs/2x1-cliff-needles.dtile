dharmatiles version="1.0.0"

// A cluster of thin pillars.

tile size="2x1" seed=1 {
    about "A cluster of thin pillars."

    region crag { within "15.5dmm" of="(1sq, 0.5sq)"; within "12.5dmm" of="(0.7sq, 0.39sq)"; within "11.5dmm" of="(1.21sq, 0.59sq)" }
    region mid1 { within "9dmm" of="(1sq, 0.5sq)" }
    region mid2 { within "7dmm" of="(0.7sq, 0.39sq)" }
    region mid3 { within "6.5dmm" of="(1.21sq, 0.59sq)" }
    region top1 { within "5dmm" of="(1sq, 0.5sq)" }
    region top2 { within "4dmm" of="(0.7sq, 0.39sq)" }
    region top3 { within "4dmm" of="(1.21sq, 0.59sq)" }
    region apron { within "6.5dmm" of=crag }

    stack {
        base
        dirt top="$dirtEdgeHeight" {
            pin top="[$dirtEdgeHeight .. $dirtEdgeHeight + 3.5dmm]" at=apron
            pin top="$dirtEdgeHeight" at=edges
            scatter perSquare=45 { pebble size="1dmm .. 2.2dmm" buried="20%..50%" }
        }

        cliff top="$dirtEdgeHeight + [3dmm .. 10dmm]" at=crag {
            pin top="$dirtEdgeHeight + [14dmm .. 26dmm]" at=mid1
            pin top="$dirtEdgeHeight + [10dmm .. 22dmm]" at=mid2
            pin top="$dirtEdgeHeight + [9dmm .. 20dmm]" at=mid3
            pin top="$dirtEdgeHeight + [44dmm .. 55dmm]" at=top1
            pin top="$dirtEdgeHeight + [34dmm .. 44dmm]" at=top2
            pin top="$dirtEdgeHeight + [31dmm .. 41dmm]" at=top3
            rock columns
            stoneSize massive
        }

        scatter at="foot(cliff)" perSquare=55 reach="4dmm" { stone size="low(1dmm .. 6dmm, 11)" }
        scatter at="foot(cliff)" perSquare=2.5 { boulder size="4.5dmm .. 8dmm" }
    }
}
