// A big free-standing outcrop with a tall core and a lower tier.

tile size="2x2" seed=1 {
    about "A big free-standing outcrop with a tall core and a lower tier."

    region crag { within 26.5 of=center }
    region crag2 { within 15 of=center }
    region apron { within 6.5 of=crag }

    stack {
        base
        dirt top=dirtEdgeHeight {
            pin top="[dirtEdgeHeight .. dirtEdgeHeight + 3.5]" at=apron
            pin top="dirtEdgeHeight + [1.5 .. 3.5]" at=crag
            scatter per-square=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff top="dirtEdgeHeight + [14.5 .. 17.5]" at=crag {
            pin top="dirtEdgeHeight + [32 .. 35]" at=crag2
            rock mixed
            stone-size massive
            shattered patches=3 width="5..10"
        }
        dirt top="bottom + [0.6 .. 1.2]" at=crag2

        scatter against=cliff per-square=55 reach=4 { stone size="1..6" mostly=small }
        scatter against=cliff per-square=2.5 { boulder size="4.5..8" }
    }
}
