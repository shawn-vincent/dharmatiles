// A big free-standing outcrop with a tall core and a lower tier.

tile size="2x2" seed=1 {
    about "A big free-standing outcrop with a tall core and a lower tier."

    region crag { within 24 of=center; within 14 of="(0.7, 0.9)"; within 12 of="(1.3, 1.2)" }
    region lump2 { within 14 of="(1, 1)"; within 9 of="(1.25, 0.8)" }
    region apron { within 6.5 of=crag }

    stack {
        base
        dirt top=dirtEdgeHeight {
            pin top="[dirtEdgeHeight .. dirtEdgeHeight + 3.5]" at=apron
            pin top=dirtEdgeHeight at=edges
            scatter perSquare=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff top="dirtEdgeHeight + [8 .. 22]" at=crag {
            pin top="dirtEdgeHeight + [18 .. 35]" at=lump2
            rock mixed
            stoneSize massive
            shattered patches=3 width="5..10"
        }
        dirt top="bottom + [0.6 .. 1.2]" at=lump2

        scatter at="foot(cliff)" perSquare=55 reach=4 { stone size="low(1..6, 11)" }
        scatter at="foot(cliff)" perSquare=2.5 { boulder size="4.5..8" }
    }
}
