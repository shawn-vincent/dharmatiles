dharmatiles version="1.0.0"

// A big free-standing outcrop with a tall core and a lower tier.

tile size="2x2" seed=1 {
    about "A big free-standing outcrop with a tall core and a lower tier."

    region crag { within "24dmm" of=center; within "14dmm" of="(0.7sq, 1.1sq)"; within "12dmm" of="(1.3sq, 0.8sq)" }
    region lump2 { within "14dmm" of="(1sq, 1sq)"; within "9dmm" of="(1.25sq, 1.2sq)" }
    region apron { within "6.5dmm" of=crag }

    stack {
        base
        dirt top="$dirtEdgeHeight" {
            pin top="[$dirtEdgeHeight .. $dirtEdgeHeight + 3.5dmm]" at=apron
            pin top="$dirtEdgeHeight" at=edges
            scatter perSquare=45 { pebble size="1dmm .. 2.2dmm" buried="20%..50%" }
        }

        cliff top="$dirtEdgeHeight + [8dmm .. 22dmm]" at=crag {
            pin top="$dirtEdgeHeight + [18dmm .. 35dmm]" at=lump2
            rock mixed
            stoneSize massive
            shattered patches=3 width="5dmm .. 10dmm"
        }
        dirt top="$bottom + [0.6dmm .. 1.2dmm]" at=lump2

        scatter at="foot(cliff)" perSquare=55 reach="4dmm" { stone size="low(1dmm .. 6dmm, 11)" }
        scatter at="foot(cliff)" perSquare=2.5 { boulder size="4.5dmm .. 8dmm" }
    }
}
