// A cliff run of big squared blocks, bare on top.

tile "2x1-cliff-blocks" size="2x1" seed=2 {
    about "A cliff run of big squared blocks, bare on top."

    stack {
        dirt level=edge {
            bank against=cliff height="1.5..3.5" reach="3..6.5"
            scatter per-square=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff along=north height=35 {
            rock blocks
            stone-size massive
            top bare
            shattered patches=2 width="5..10"
        }

        scatter against=cliff per-square=55 reach=4 { stone size="1..6" mostly=small }
        scatter against=cliff per-square=2.5 { boulder size="4.5..8" }
    }
}
