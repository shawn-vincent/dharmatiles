dharmatiles version="1.0.0"

// A single tall pillar of rock.

tile size="1x1" seed=2 {
    about "A single tall pillar of rock."

    region crag { within "12dmm" of=center; within "8dmm" of="(0.45sq, 0.45sq)" }
    region lump2 { within "8dmm" of="(0.5sq, 0.5sq)"; within "5.5dmm" of="(0.55sq, 0.55sq)" }
    region lump3 { within "5.5dmm" of="(0.5sq, 0.5sq)"; within "3.5dmm" of="(0.45sq, 0.45sq)" }
    region lump4 { within "4.5dmm" of="(0.5sq, 0.5sq)" }
    region apron { within "6.5dmm" of=crag }

    stack {
        base
        dirt top="$dirtEdgeHeight" {
            pin top="[$dirtEdgeHeight .. $dirtEdgeHeight + 3.5dmm]" at=apron
            pin top="$dirtEdgeHeight" at=edges
            scatter perSquare=45 { pebble size="1dmm .. 2.2dmm" buried="20%..50%" }
        }

        cliff top="$dirtEdgeHeight + [3.5dmm .. 12dmm]" at=crag {
            pin top="$dirtEdgeHeight + [9dmm .. 26dmm]" at=lump2
            pin top="$dirtEdgeHeight + [22dmm .. 44dmm]" at=lump3
            pin top="$dirtEdgeHeight + [40dmm .. 58dmm]" at=lump4
            rock columns
            stoneSize massive
        }

        scatter at="foot(cliff)" perSquare=55 reach="4dmm" { stone size="low(1dmm .. 6dmm, 11)" }
        scatter at="foot(cliff)" perSquare=2.5 { boulder size="4.5dmm .. 8dmm" }
    }
}
