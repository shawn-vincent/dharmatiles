dharmatiles version="1.0.0"

// A rounded heap of rock.

tile size="1x1" seed=1 {
    about "A rounded heap of rock."

    region crag { within "13.5dmm" of=center; within "9dmm" of="(0.42sq, 0.45sq)"; within "8dmm" of="(0.6sq, 0.55sq)" }
    region lump2 { within "9dmm" of="(0.47sq, 0.47sq)"; within "6.5dmm" of="(0.58sq, 0.56sq)" }
    region lump3 { within "6.5dmm" of="(0.5sq, 0.5sq)"; within "4.5dmm" of="(0.4sq, 0.43sq)" }
    region lump4 { within "3.8dmm" of="(0.52sq, 0.53sq)" }
    region apron { within "6.5dmm" of=crag }

    stack {
        base
        dirt top="$dirtEdgeHeight" {
            pin top="[$dirtEdgeHeight .. $dirtEdgeHeight + 3.5dmm]" at=apron
            pin top="$dirtEdgeHeight" at=edges
            scatter perSquare=45 { pebble size="1dmm .. 2.2dmm" buried="20%..50%" }
        }

        cliff top="$dirtEdgeHeight + [3dmm .. 12dmm]" at=crag {
            pin top="$dirtEdgeHeight + [9dmm .. 22dmm]" at=lump2
            pin top="$dirtEdgeHeight + [17dmm .. 30dmm]" at=lump3
            pin top="$dirtEdgeHeight + [25dmm .. 34dmm]" at=lump4
            rock mixed
            stoneSize broken
        }
        dirt top="$bottom + [0.6dmm .. 1.2dmm]" at=lump4

        scatter at="foot(cliff)" perSquare=55 reach="4dmm" { stone size="low(1dmm .. 6dmm, 11)" }
        scatter at="foot(cliff)" perSquare=2.5 { boulder size="4.5dmm .. 8dmm" }
    }
}
