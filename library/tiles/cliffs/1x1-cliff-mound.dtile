// A rounded heap of rock.

tile size="1x1" seed=1 {
    about "A rounded heap of rock."

    region crag { within 13.5 of=center; within 9 of="(0.42, 0.55)"; within 8 of="(0.6, 0.45)" }
    region lump2 { within 9 of="(0.47, 0.53)"; within 6.5 of="(0.58, 0.44)" }
    region lump3 { within 6.5 of="(0.5, 0.5)"; within 4.5 of="(0.4, 0.57)" }
    region lump4 { within 3.8 of="(0.52, 0.47)" }
    region apron { within 6.5 of=crag }

    stack {
        base
        dirt top=dirtEdgeHeight {
            pin top="[dirtEdgeHeight .. dirtEdgeHeight + 3.5]" at=apron
            pin top=dirtEdgeHeight at=edges
            scatter perSquare=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff top="dirtEdgeHeight + [3 .. 12]" at=crag {
            pin top="dirtEdgeHeight + [9 .. 22]" at=lump2
            pin top="dirtEdgeHeight + [17 .. 30]" at=lump3
            pin top="dirtEdgeHeight + [25 .. 34]" at=lump4
            rock mixed
            stoneSize broken
        }
        dirt top="bottom + [0.6 .. 1.2]" at=lump4

        scatter against=cliff perSquare=55 reach=4 { stone size="low(1..6, 11)" }
        scatter against=cliff perSquare=2.5 { boulder size="4.5..8" }
    }
}
