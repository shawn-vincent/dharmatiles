// A tall corner of stacked slabs round the north-west corner.

tile size="2x2" seed=1 {
    about "A tall corner of stacked slabs round the north-west corner."

    region crag { within "[10 .. 20]" of=northEdge; within "[10 .. 20]" of=westEdge }
    region apron { within 6.5 of=crag }

    stack {
        base
        dirt top=dirtEdgeHeight {
            pin top="[dirtEdgeHeight .. dirtEdgeHeight + 3.5]" at=apron
            pin top=dirtEdgeHeight at=edges
            scatter perSquare=45 { pebble size="1..2.2" buried="20%..50%" }
        }

        cliff top="dirtEdgeHeight + 45" at=crag {
            rock slabs
            stoneSize massive
            shattered patches=3 width="5..10"
        }
        dirt top="bottom + [0.6 .. 1.2]" at=crag

        scatter against=cliff perSquare=55 reach=4 { stone size="low(1..6, 11)" }
        scatter against=cliff perSquare=2.5 { boulder size="4.5..8" }
    }
}
