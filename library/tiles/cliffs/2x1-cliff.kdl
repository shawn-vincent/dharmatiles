// A 2×1 cliff run: a band of stacked rock against the north edge.
// Twin of clifflab/rockpile.py's `run` form, frozen at round 17 (31f7c5d)
// with its foot at the edge level (3.4 mm, Default 12).
//
// Ported so far: the form (masses, tiers, the standard end section), the
// stack (columns, blocks, slabs, odd lumps, monoliths), arris chamfers,
// grain and the core. Not yet: the crack network, shattered patches,
// ledges, dirt lodged on the top, the bank against the foot and the
// scree (`scatter against=cliff`): the plan's later list.

tile cliff-run size="2x1" seed=1 {
    about """
        Rock band against the north edge. Both ends finish in the
        standard end section, so runs butt end to end.
        """

    stack {
        dirt level=edge

        cliff along=north height=35 {   // 35 mm above its foot
            rock mixed                  // or: columns, blocks, slabs
            stone-size massive          // or: rubble, broken
        }
    }
}
