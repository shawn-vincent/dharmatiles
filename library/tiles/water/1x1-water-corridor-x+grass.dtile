// Water crossing four ways through a meadow.

tile size="1x1" seed=66 {
    about "Water crossing four ways through a meadow."
    line shore-sw { through "0,0.43" "0.43,0" }
    line shore-nw { through "0,0.57" "0.43,1" }
    line shore-ne { through "0.57,1" "1,0.57" }
    line shore-se { through "1,0.43" "0.57,0" }
    region channel { boundedBy shore-sw shore-nw shore-ne shore-se; fill "0.5,0.5" }
    region bank { boundedBy shore-sw shore-nw shore-ne shore-se; fill "0.08,0.08"; fill "0.08,0.92"; fill "0.92,0.92"; fill "0.92,0.08" }
    region shoreBand { within 7 of=shore-sw; within 7 of=shore-nw; within 7 of=shore-ne; within 7 of=shore-se }
    stack {
        base
        dirt {
            pin top="[waterBedHeight .. groundHeight + 1]" at=shoreBand   // anywhere from the bed to the land
            pin top=waterBedHeight at=channel   // the bed, written last so it wins
        }
        water
        rock at=channel size="6..10"
        grass at=bank
    }
}
