// Water in the lower half, a dirt bank in the upper, with a wandering shore.

tile water+soil size="1x1" seed=50 {
    about "Water in the lower half, a dirt bank in the upper, with a wandering shore."
    line shore wobble=5 { through "0,0.38" "1,0.42" }
    region pool { bounded-by shore; fill "0.5,0.25" }
    region bank { bounded-by shore; fill "0.5,0.75" }
    stack {
        dirt in=bank
        ground in=pool level="water - 2.2"
        scatter in=pool count=2 { rock size="6..10" }
        water
    }
}
