// A cove of water cut in from the east edge through a meadow.

tile water-u+grass size="1x1" seed=63 {
    about "A cove of water cut in from the east edge through a meadow."
    line shore wobble=1.5 { through "1,0.43" "0.62,0.3" "0.38,0.43" "0.44,0.57" "0.64,0.7" "1,0.57" }
    region cove { bounded-by shore; fill "0.85,0.5" }
    region bank { bounded-by shore; fill "0.2,0.5" }
    stack {
        dirt in=bank
        grass in=bank
        ground in=cove level="water - 2.2"
        scatter in=cove count=2 { rock size="5..9" }
        water
    }
}
