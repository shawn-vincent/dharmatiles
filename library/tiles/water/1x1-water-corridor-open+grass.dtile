// A channel from the west edge opening into broad water to the east.

tile water-corridor-open+grass size="1x1" seed=67 {
    about "A channel from the west edge opening into broad water to the east."
    line shore-south wobble=1.5 { through "0,0.43" "0.6,0" }
    line shore-north wobble=1.5 { through "0,0.57" "0.6,1" }
    region channel { bounded-by shore-north shore-south; fill "0.75,0.5" }
    region bank { bounded-by shore-north shore-south; fill "0.08,0.08"; fill "0.08,0.92" }
    stack {
        dirt in=bank
        grass in=bank
        ground in=channel level="water - 2.2"
        rock in=channel size="6..10"
        water
    }
}
