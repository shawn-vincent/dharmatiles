// The twin of src/tiles/water/1x1-water-corridor-t+grass.tile.py (the Python library tile, kept).
// Water in a T, open to the west, east and north edges.
// Port notes: the pool bed sits 2.2 mm under the water level (waterlab's
// bed), the water is waterlab's swell-chaos at the standard water level
// (2.6 mm; the Python pool was 3 mm), and the bank is dirtlab's dirt,
// banked down to the bed over 7 mm.  The bank is all on the land side
// (waterlab's), so each shore line is drawn 0.1 square (3.5 mm) toward
// the water from the Python anchor: the waterline lands where it was.  The Python shoreline strip (soil
// plus 40–60 shore pebbles a square) is the dirt's own pebbles here.

tile water-corridor-t+grass size="1x1" seed=65 {
    about "Water in a T, open to the west, east and north edges."
    line shore-south wobble=1.5 { through "0,0.43" "1,0.43" }
    line shore-northwest wobble=1.5 { through "0,0.57" "0.44,0.58" "0.43,1" }
    line shore-northeast wobble=1.5 { through "0.57,1" "0.56,0.58" "1,0.57" }
    region channel { bounded-by shore-south shore-northwest shore-northeast; fill "0.5,0.5" }
    region bank { bounded-by shore-south shore-northwest shore-northeast; fill "0.18,0.88"; fill "0.82,0.88"; fill "0.5,0.18" }
    stack {
        dirt in=bank
        grass in=bank
        ground in=channel level="water - 2.2"
        rock in=channel size="6..10"
        water
    }
}
