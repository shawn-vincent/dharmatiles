// Water in a T, open to the west, east and north edges.

tile size="1x1" seed=65 {
    about "Water in a T, open to the west, east and north edges."
    line shore-south wobble=1.5 { through "0,0.43" "1,0.43" }
    line shore-northwest wobble=1.5 { through "0,0.57" "0.44,0.58" "0.43,1" }
    line shore-northeast wobble=1.5 { through "0.57,1" "0.56,0.58" "1,0.57" }
    region channel { bounded-by shore-south shore-northwest shore-northeast; fill "0.5,0.5" }
    region bank { bounded-by shore-south shore-northwest shore-northeast; fill "0.18,0.88"; fill "0.82,0.88"; fill "0.5,0.18" }
    region shoreBand { within 7 of=shore-south; within 7 of=shore-northwest; within 7 of=shore-northeast }
    stack {
        base
        dirt {
            pin top="[waterBedHeight .. groundHeight + 1]" at=shoreBand   // anywhere from the bed to the land
            pin top=waterBedHeight at=channel   // the bed, written last so it wins
        }
        grass in=bank
        rock in=channel size="6..10"
        water
    }
}
