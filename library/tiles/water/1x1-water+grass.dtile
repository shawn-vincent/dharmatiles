// Water in the lower half, a meadow bank in the upper, with a wandering
// shore.

tile size="1x1" seed=97 {
    about "Water in the lower half, a meadow bank in the upper, with a wandering shore."
    line shore wobble=5 { through "0,0.38" "1,0.42" }
    region pool { bounded-by shore; fill "0.5,0.25" }
    region bank { bounded-by shore; fill "0.5,0.75" }
    region shoreBand { within 7 of=shore }
    stack {
        base
        dirt {
            pin top="[waterBedHeight .. groundHeight + 1]" at=shoreBand   // anywhere from the bed to the land
            pin top=waterBedHeight at=pool   // the bed, written last so it wins
        }
        grass in=bank
        scatter in=pool count=2 { rock size="6..10" }
        water
    }
}
