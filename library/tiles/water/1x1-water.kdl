// The twin of src/tiles/water/1x1-water.tile.py (the Python library tile, kept).
// A whole square of water, waterlab's swell-chaos.
// Port notes: the pool bed sits 2.2 mm under the water level (waterlab's
// bed), the water is waterlab's swell-chaos at the standard water level
// (2.6 mm; the Python pool was 3 mm), and the bank is dirtlab's dirt,
// banked down to the bed over 7 mm.  The Python shoreline strip (soil
// plus 40–60 shore pebbles a square) is the dirt's own pebbles here.

tile water size="1x1" seed=17 {
    about "A whole square of water, waterlab's swell-chaos."
    stack {
        ground level="water - 2.2"
        water
    }
}
