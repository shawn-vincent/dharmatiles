dharmatiles version="1.0.0"

// Water in a T, open to the west, east and north edges.

tile size="1x1" seed=56 {
    about "Water in a T, open to the west, east and north edges."
    line shore-south wobble="1.5dmm" { through "(0sq, 0.57sq)" "(1sq, 0.57sq)" }
    line shore-northwest wobble="1.5dmm" { through "(0sq, 0.43sq)" "(0.44sq, 0.42sq)" "(0.43sq, 0sq)" }
    line shore-northeast wobble="1.5dmm" { through "(0.57sq, 0sq)" "(0.56sq, 0.42sq)" "(1sq, 0.43sq)" }
    region channel { boundedBy shore-south shore-northwest shore-northeast; fill "(0.5sq, 0.5sq)" }
    region bank { boundedBy shore-south shore-northwest shore-northeast; fill "(0.18sq, 0.12sq)"; fill "(0.82sq, 0.12sq)"; fill "(0.5sq, 0.82sq)" }
    region shoreBand { within "7dmm" of=shore-south; within "7dmm" of=shore-northwest; within "7dmm" of=shore-northeast }
    stack {
        base
        dirt {
            pin top="[$waterBedHeight .. $groundHeight + 1dmm]" at=shoreBand   // anywhere from the bed to the land
            pin top="$waterBedHeight" at=channel   // the bed, written last so it wins
        }
        rock at=channel size="6dmm .. 10dmm"
        water
    }
}
