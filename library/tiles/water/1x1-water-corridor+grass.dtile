// A channel of water west to east between two meadow banks.

tile size="1x1" seed=62 {
    about "A channel of water west to east between two meadow banks."
    line shore-north wobble=1.5 { through "0,0.57" "1,0.57" }
    line shore-south wobble=1.5 { through "0,0.43" "1,0.43" }
    region channel { boundedBy shore-north shore-south; fill "0.5,0.5" }
    region bank { boundedBy shore-north shore-south; fill "0.5,0.85"; fill "0.5,0.15" }
    region shoreBand { within 7 of=shore-north; within 7 of=shore-south }
    stack {
        base
        dirt {
            pin top="[waterBedHeight .. groundHeight + 1]" at=shoreBand   // anywhere from the bed to the land
            pin top=waterBedHeight at=channel   // the bed, written last so it wins
        }
        water
        rock at=channel size="6..10"
        grass at=bank
    }
}
