dharmatiles version="1.0.0"

// A channel of water west to east between two meadow banks.

tile size="1x1" seed=62 {
    about "A channel of water west to east between two meadow banks."
    line shore-north wobble="1.5dmm" { through "(0sq, 0.43sq)" "(1sq, 0.43sq)" }
    line shore-south wobble="1.5dmm" { through "(0sq, 0.57sq)" "(1sq, 0.57sq)" }
    region channel { boundedBy shore-north shore-south; fill "(0.5sq, 0.5sq)" }
    region bank { boundedBy shore-north shore-south; fill "(0.5sq, 0.15sq)"; fill "(0.5sq, 0.85sq)" }
    region shoreBand { within "7dmm" of=shore-north; within "7dmm" of=shore-south }
    stack {
        base
        dirt {
            pin top="[$waterBedHeight .. $groundHeight + 1dmm]" at=shoreBand   // anywhere from the bed to the land
            pin top="$waterBedHeight" at=channel   // the bed, written last so it wins
        }
        rock at=channel size="6dmm .. 10dmm"
        water
        grass at=bank
    }
}
