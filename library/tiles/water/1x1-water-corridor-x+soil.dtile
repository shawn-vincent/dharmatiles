// The twin of src/tiles/water/1x1-water-corridor-x+soil.tile.py (the Python library tile, kept).
// Water crossing four ways through dirt.
// Port notes: the pool bed sits 2.2 mm under the water level (waterlab's
// bed), the water is waterlab's swell-chaos at the standard water level
// (2.6 mm; the Python pool was 3 mm), and the bank is dirtlab's dirt,
// banked down to the bed over 7 mm.  The bank is all on the land side
// (waterlab's), so each shore line is drawn 0.1 square (3.5 mm) toward
// the water from the Python anchor: the waterline lands where it was.  The Python shoreline strip (soil
// plus 40–60 shore pebbles a square) is the dirt's own pebbles here.

tile water-corridor-x+soil size="1x1" seed=57 {
    about "Water crossing four ways through dirt."
    line shore-sw { through "0,0.43" "0.43,0" }
    line shore-nw { through "0,0.57" "0.43,1" }
    line shore-ne { through "0.57,1" "1,0.57" }
    line shore-se { through "1,0.43" "0.57,0" }
    region channel { bounded-by shore-sw shore-nw shore-ne shore-se; fill "0.5,0.5" }
    region bank { bounded-by shore-sw shore-nw shore-ne shore-se; fill "0.08,0.08"; fill "0.08,0.92"; fill "0.92,0.92"; fill "0.92,0.08" }
    stack {
        dirt in=bank
        ground in=channel level="water - 2.2"
        rock in=channel size="6..10"
        water
    }
}
