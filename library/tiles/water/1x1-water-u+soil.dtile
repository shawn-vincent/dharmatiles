// A cove of water cut in from the east edge through dirt.

tile size="1x1" seed=54 {
    about "A cove of water cut in from the east edge through dirt."
    line shore wobble=1.5 { through "1,0.43" "0.62,0.3" "0.38,0.43" "0.44,0.57" "0.64,0.7" "1,0.57" }
    region cove { bounded-by shore; fill "0.85,0.5" }
    region bank { bounded-by shore; fill "0.2,0.5" }
    region shoreBand { within 7 of=shore }
    stack {
        base
        dirt {
            pin top="[waterBedHeight .. groundHeight + 1]" at=shoreBand   // anywhere from the bed to the land
            pin top=waterBedHeight at=cove   // the bed, written last so it wins
        }
        scatter in=cove count=2 { rock size="5..9" }
        water
    }
}
