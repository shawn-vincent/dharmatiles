dharmatiles version="1.0.0"

// A meadow bank with one tree and a few big rocks, and a pool below it.

use "parts/grass" long-grass

tile size="1x1" seed=53 {
    about "A meadow bank with a tree and rocks above a pool."
    line shore wobble="5dmm" { through "(0sq, 0.62sq)" "(1sq, 0.58sq)" }
    region pool { boundedBy shore; fill "(0.5sq, 0.75sq)" }
    region bank { boundedBy shore; fill "(0.5sq, 0.25sq)" }
    region shoreBand { within "7dmm" of=shore }
    stack {
        base
        dirt {
            pin top="[$waterBedHeight .. $groundHeight + 1dmm]" at=shoreBand   // anywhere from the bed to the land
            pin top="$waterBedHeight" at=pool   // the bed, written last so it wins
        }
        scatter at=bank perSquare=3 gap="7dmm" {    // rocks first: grass grows round them
            boulder size="7dmm .. 9dmm" shape=angular
        }
        tree at=bank top="$bottom + 35dmm" {
            trunk height="30dmm"
            crown width="24dmm" clumps=32 shape=round branching=normal
            leaf length="4.5dmm" width="3dmm"
        }
        scatter at=pool count=3 { rock size="5dmm .. 9dmm" }
        water
        long-grass at=bank                       // grows round the trunk and rocks
    }
}
