// A shallow pool tucked into the south-west corner of a dirt bank.

tile size="1x1" seed=52 {
    about "A shallow pool tucked into the south-west corner of a dirt bank."
    line shore wobble=2.5 { through "0,0.4" "0.4,0" }
    region pool { bounded-by shore; fill "0.1,0.1" }
    region bank { bounded-by shore; fill "0.75,0.75" }
    stack {
        dirt in=bank
        ground in=pool level="water - 2.2"
        scatter in=pool count=3 { rock size="4..8" }
        water
    }
}
