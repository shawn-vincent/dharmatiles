dharmatiles version="1.0.0"

// A shallow pool tucked into the south-west corner of a meadow bank.

tile size="1x1" seed=61 {
    about "A shallow pool tucked into the south-west corner of a meadow bank."
    line shore wobble="2.5dmm" { through "(0sq, 0.5sq)" "(0.5sq, 1sq)" }
    region pool { boundedBy shore; fill "(0.1sq, 0.9sq)" }
    region bank { boundedBy shore; fill "(0.75sq, 0.25sq)" }
    region shoreBand { within "7dmm" of=shore }
    stack {
        base
        dirt {
            pin top="[$waterBedHeight .. $groundHeight + 1dmm]" at=shoreBand   // anywhere from the bed to the land
            pin top="$waterBedHeight" at=pool   // the bed, written last so it wins
        }
        scatter at=pool count=3 { rock size="4dmm .. 8dmm" }
        water
        grass at=bank
    }
}
