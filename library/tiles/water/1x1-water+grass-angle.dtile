// A shallow pool tucked into the south-west corner of a meadow bank.

tile size="1x1" seed=61 {
    about "A shallow pool tucked into the south-west corner of a meadow bank."
    line shore wobble=2.5 { through "0,0.4" "0.4,0" }
    region pool { boundedBy shore; fill "0.1,0.1" }
    region bank { boundedBy shore; fill "0.75,0.75" }
    region shoreBand { within 7 of=shore }
    stack {
        base
        dirt {
            pin top="[waterBedHeight .. groundHeight + 1]" at=shoreBand   // anywhere from the bed to the land
            pin top=waterBedHeight at=pool   // the bed, written last so it wins
        }
        water
        scatter at=pool count=3 { rock size="4..8" }
        grass at=bank
    }
}
