// A channel of water west to east between two dirt banks.

tile water-corridor+soil size="1x1" seed=53 {
    about "A channel of water west to east between two dirt banks."
    line shore-north wobble=1.5 { through "0,0.57" "1,0.57" }
    line shore-south wobble=1.5 { through "0,0.43" "1,0.43" }
    region channel { bounded-by shore-north shore-south; fill "0.5,0.5" }
    region bank { bounded-by shore-north shore-south; fill "0.5,0.85"; fill "0.5,0.15" }
    stack {
        dirt in=bank
        ground in=channel level="water - 2.2"
        rock in=channel size="6..10"
        water
    }
}
