// Bare earth on one square: the twin of src/tiles/ground/1x1-soil.tile.py
// (seed 13).  The Python tile is the library's older SoilCarpet; this is
// dirtlab's dirt, the exposed ground every look now uses (29 Oct 2026).

tile soil size="1x1" seed=13 {
    about "Bare earth: clods, grit and half-sunk pebbles over gentle rises."
    stack {
        dirt bumps=2.5 bump-size=14 {   // rises up to 2.5 mm, about 14 mm across
            clods some                  // or: few, many
        }
    }
}
