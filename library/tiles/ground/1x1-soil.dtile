dharmatiles version="1.0.0"

// Bare earth on one square (seed 13).

tile size="1x1" seed=13 {
    about "Bare earth: clods, grit and half-sunk pebbles over gentle rises."
    stack {
        base
        dirt bumpSize="14dmm" top="[$groundHeight .. $groundHeight + 2.5dmm]" {
   // rises up to 2.5dmm, about 14dmm across
            clods some                  // or: few, many
        }
    }
}
