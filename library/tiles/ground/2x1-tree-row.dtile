// A 2×1 meadow with a row of three trees along a line: a hedge or the
// edge of a road.

use "parts/grass" long-grass

tile size="2x1" seed=21 {
    line row wobble=3 { through "0,0.5" "1,0.58" "2,0.5" }
    stack {
        base
        dirt clods=none stones=none
        scatter at=row count=3 reach=3 gap=1 {      // trees first: grass grows round the trunks
            tree size="26..32" {
                trunk height=14
                crown width=16 clumps=24 shape=round branching=normal
                leaf length=4.5 width=3
            }
        }
        long-grass                                   // grows round the trunks
    }
}
