tile soil+grass size="1x1" seed=42 {
    about "Grass on the left half, bare dirt on the right, with an organic margin."
    line margin wobble=5 { through "0.48,1" "0.52,0" }
    region meadow { bounded-by margin; fill "0.25,0.5" }
    region path { bounded-by margin; fill "0.75,0.5" }
    stack {
        dirt
        grass in=meadow
    }
}
