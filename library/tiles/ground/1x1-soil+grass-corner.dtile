dharmatiles version="1.0.0"

tile size="1x1" seed=99 {
    about "A patch of grass in the south-west corner; the rest is bare dirt."
    line margin wobble="2.5dmm" { through "(0sq, 0.5sq)" "(0.5sq, 1sq)" }
    region patch { boundedBy margin; fill "(0.15sq, 0.85sq)" }
    region path { boundedBy margin; fill "(0.75sq, 0.25sq)" }
    stack {
        base
        dirt
        grass at=patch
    }
}
