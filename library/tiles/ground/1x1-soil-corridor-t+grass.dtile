dharmatiles version="1.0.0"

tile size="1x1" seed=104 {
    about "A dirt path in a T, open to the west, east and north edges."
    line south-margin wobble="3dmm" { through "(0sq, 2sq/3)" "(1sq, 2sq/3)" }
    line northwest-margin wobble="2.2dmm" { through "(0sq, 1sq/3)" "(1sq/3, 0sq)" }
    line northeast-margin wobble="2.2dmm" { through "(2sq/3, 0sq)" "(1sq, 1sq/3)" }
    region path { boundedBy south-margin northwest-margin northeast-margin; fill "(0.5sq, 0.5sq)" }
    region meadow { boundedBy south-margin northwest-margin northeast-margin; fill "(0.18sq, 0.12sq)"; fill "(0.82sq, 0.12sq)"; fill "(0.5sq, 0.82sq)" }
    stack {
        base
        dirt
        grass at=meadow
    }
}
