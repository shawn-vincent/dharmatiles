dharmatiles version="1.0.0"

// A 1×1 grass meadow with one tree and a few big rocks.

use "parts/grass" long-grass

tile size="1x1" seed=42 {
    stack {
        base
        dirt clods=none
        scatter perSquare=3 gap="7dmm" {    // rocks first: grass grows round them
            boulder size="7dmm .. 9dmm" shape=angular
        }
        tree top="$bottom + 44dmm" {     // anywhere on the tile
            trunk height="30dmm"
            crown width="24dmm" clumps=32 shape=round branching=normal
            leaf length="4.5dmm" width="3dmm"
        }
        long-grass                      // grows round the trunk and rocks
    }
}
