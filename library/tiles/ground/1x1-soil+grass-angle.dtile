tile size="1x1" seed=100 {
    about "Dirt tucked into the south-west corner of a meadow."
    line margin wobble=2.5 { through "0,0.5" "0.5,0" }
    region path { boundedBy margin; fill "0.15,0.15" }
    region meadow { boundedBy margin; fill "0.75,0.75" }
    stack {
        base
        dirt
        grass in=meadow
    }
}
