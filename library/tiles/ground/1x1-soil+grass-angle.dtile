dharmatiles version="1.0.0"

tile size="1x1" seed=100 {
    about "Dirt tucked into the south-west corner of a meadow."
    line margin wobble="2.5dmm" { through "(0sq, 0.5sq)" "(0.5sq, 1sq)" }
    region path { boundedBy margin; fill "(0.15sq, 0.85sq)" }
    region meadow { boundedBy margin; fill "(0.75sq, 0.25sq)" }
    stack {
        base
        dirt
        grass at=meadow
    }
}
