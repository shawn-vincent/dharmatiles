// The flowers stand first, so the grass knows their footprints and grows
// round them, never through them.

use "parts/grass" lawn

tile size="1x1" seed=7 {
    about "A meadow with four wildflowers."
    stack {
        dirt
        flowers per-square=4 petals=5 radius=2.5 centre=1.5 stem=1 dome=1 petal=0.5
        lawn
    }
}
