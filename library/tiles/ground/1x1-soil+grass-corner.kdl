// The twin of src/tiles/ground/1x1-soil+grass-corner.tile.py (the Python library tile, kept).

tile soil+grass-corner size="1x1" seed=99 {
    about "A patch of grass in the south-west corner; the rest is bare dirt."
    line margin wobble=2.5 { through "0,0.5" "0.5,0" }
    region patch { bounded-by margin; fill "0.15,0.15" }
    region path { bounded-by margin; fill "0.75,0.75" }
    stack {
        dirt
        grass in=patch
    }
}
