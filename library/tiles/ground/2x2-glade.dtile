dharmatiles version="1.0.0"

// A 2×2 glade: one scatter of a tree, rocks and wildflowers. The tree is
// placed first and the rocks and flowers fill the room around it; each
// child's weight is its share of the mix.

use "parts/grass" lawn

tile size="2x2" seed=5 {
    stack {
        base
        dirt clods=none
        scatter count=10 gap="1.5dmm" {
            tree top="$bottom + [39dmm .. 45dmm]" weight=1 {
                trunk height="16dmm"
                crown width="18dmm" clumps=24 shape=round branching=normal
                leaf length="4.5dmm" width="3dmm"
            }
            rock size="4dmm .. 8dmm" weight=3
            flower size="4dmm .. 6dmm" weight=3
        }
        lawn                                     // grows round all three
    }
}
