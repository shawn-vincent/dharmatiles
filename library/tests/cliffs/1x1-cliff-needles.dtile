dharmatiles version="1.0.0"

// Two or three tall stacks on a shared footing.

tile size="1x1" seed=1 {
    about """
        Two or three tall stacks on a shared footing.
        """

    region crag { within "15.5dmm" of="(0.5sq, 0.5sq)"; within "12.5dmm" of="(0.2sq, 0.39sq)"; within "11.5dmm" of="(0.71sq, 0.59sq)" }
    region cragn1r1 { within "12dmm" of="(0.5sq, 0.5sq)" }
    region cragn2r1 { within "9.5dmm" of="(0.2sq, 0.39sq)" }
    region cragn3r1 { within "9dmm" of="(0.71sq, 0.59sq)" }
    region cragn1r2 { within "8dmm" of="(0.5sq, 0.5sq)" }
    region cragn2r2 { within "6.5dmm" of="(0.2sq, 0.39sq)" }
    region cragn3r2 { within "6dmm" of="(0.71sq, 0.59sq)" }
    region cragn1r3 { within "5dmm" of="(0.5sq, 0.5sq)" }
    region cragn2r3 { within "4dmm" of="(0.2sq, 0.39sq)" }
    region cragn3r3 { within "4dmm" of="(0.71sq, 0.59sq)" }
    region apron { within "6.5dmm" of=crag }

    stack {
        base
        dirt top="$dirtEdgeHeight" {
            pin top="[$dirtEdgeHeight .. $dirtEdgeHeight + 3.5dmm]" at=apron
            pin top="$dirtEdgeHeight + [1.5dmm .. 3.5dmm]" at=crag
            scatter perSquare=45 { pebble size="1dmm .. 2.2dmm" buried="20%..50%" }
        }

        cliff top="$dirtEdgeHeight + [3dmm .. 10dmm]" at=crag {
            pin top="$dirtEdgeHeight + [4.5dmm .. 7.5dmm]" at=cragn1r1
            pin top="$dirtEdgeHeight + [3dmm .. 6dmm]" at=cragn2r1
            pin top="$dirtEdgeHeight + [3dmm .. 6dmm]" at=cragn3r1
            pin top="$dirtEdgeHeight + [20dmm .. 23dmm]" at=cragn1r2
            pin top="$dirtEdgeHeight + [15.5dmm .. 18.5dmm]" at=cragn2r2
            pin top="$dirtEdgeHeight + [14.5dmm .. 17.5dmm]" at=cragn3r2
            pin top="$dirtEdgeHeight + [52dmm .. 55dmm]" at=cragn1r3
            pin top="$dirtEdgeHeight + [41dmm .. 44dmm]" at=cragn2r3
            pin top="$dirtEdgeHeight + [38.5dmm .. 41.5dmm]" at=cragn3r3
            rock mixed
            stoneSize massive
        }

        scatter at="foot(cliff)" perSquare=55 reach="4dmm" { stone size="low(1dmm .. 6dmm, 11)" }
        scatter at="foot(cliff)" perSquare=2.5 { boulder size="4.5dmm .. 8dmm" }
    }
}
