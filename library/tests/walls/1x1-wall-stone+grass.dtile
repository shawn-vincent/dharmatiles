dharmatiles version="1.0.0"

// A copy of the library's tiles/walls/1x1-wall-stone, kept as a test tile so the
// library's own can change without touching the tests.
// A chipped cut-stone wall along the north edge of a grassy 1×1.

use "parts/grass" lawn

tile size="1x1" seed=61 {
    about "A chipped cut-stone wall along the north edge, grass to its foot: a test tile."
    stack {
        base
        dirt                                // bare earth at the ground level

        // On a tile edge a wall always stands inside, its outer face
        // flush with the edge.
        wall at="north" style=cut-stone seed=11 {
            height full                     // up to the wall-top level (33.1dmm)
            thickness "7dmm"
        }

        lawn
    }
}
