dharmatiles version="1.0.0"

// A copy of the library's tiles/floors/1x1-floor-stone-wall, kept as a test tile so the
// library's own can change without touching the tests.

tile size="1x1" seed=72 {
    about "A stone floor with a wall standing on it: a test tile."
    stack {
        base
        dirt
        flagstones texture=chipped seed=22
        wall at="north" style=cut-stone seed=23
    }
}
