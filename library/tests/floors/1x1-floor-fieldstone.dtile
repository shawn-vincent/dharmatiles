dharmatiles version="1.0.0"

// A grass-free drystone flagstone floor (a fieldstone wall laid flat) on
// a 1×1, for golden tests.

tile size="1x1" seed=1 {
    about "Drystone flagstones on one square, for golden tests."
    stack {
        base
        dirt
        flagstones style=fieldstone
    }
}
