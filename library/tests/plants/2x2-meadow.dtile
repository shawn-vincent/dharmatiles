dharmatiles version="1.0.0"

// The rocks are built first, so the grass knows their footprints: no blade
// roots under a rock, blades stop pressed against it and stand lower beside
// it, and the flow wraps it.

tile size="2x2" seed=1 {
    about "Rocks and grass on dirt: a test tile."
    stack {
        base
        dirt top="$dirtEdgeHeight" {
        }
        scatter perSquare="1.5..2.25" gap="1.5dmm" {
            rock                       // size="6..15"
        }
        grass bare="20%"
    }
}
