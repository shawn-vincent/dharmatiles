dharmatiles version="1.0.0"

// Taller than wide (rows over columns), split corner to corner: catches a
// swapped axis, and a region that narrows to a point at two corners.

tile size="1x2" seed=2 {
    about "A 1×2 split corner to corner: water below the diagonal, grass above."
    line split { through "(0sq, 2sq)" "(1sq, 0sq)" }
    region low { boundedBy split; fill "(0.8sq, 1.7sq)" }
    region high { boundedBy split; fill "(0.2sq, 0.3sq)" }
    region bank { within "5dmm" of=split }
    stack {
        base
        dirt {
            pin top="[$waterBedHeight .. $dirtEdgeHeight]" at=bank
            pin top="$waterBedHeight" at=low
        }
        water
        grass at=high
    }
}
