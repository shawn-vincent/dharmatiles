dharmatiles version="1.0.0"

// A copy of the library's tiles/water/1x1-water+grass, kept as a test tile so the
// library's own can change without touching the tests.
// Water in the lower half, a meadow bank in the upper, with a wandering
// shore.

tile size="1x1" seed=97 {
    about "Water in the lower half, a meadow bank in the upper, with a wandering shore."
    line shore wobble="5dmm" { through "(0sq, 0.5sq)" "(1sq, 0.5sq)" }
    region pool { boundedBy shore; fill "(0.5sq, 0.75sq)" }
    region bank { boundedBy shore; fill "(0.5sq, 0.25sq)" }
    region shoreBand { within "7dmm" of=shore }
    stack {
        base
        dirt {
            pin top="[$waterBedHeight .. $groundHeight + 1dmm]" at=shoreBand   // anywhere from the bed to the land
            pin top="$waterBedHeight" at=pool   // the bed, written last so it wins
        }
        scatter at=pool count=2 { rock size="6dmm .. 10dmm" }
        water
        grass at=bank
    }
}
