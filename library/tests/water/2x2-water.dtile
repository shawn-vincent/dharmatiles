dharmatiles version="1.0.0"

tile size="2x2" seed=1 {
    about "Water by a bank, with a rock in it: a test tile."
    line shore wobble="4dmm" {
        through "(0.486sq, 2sq)" "(0.486sq, 0sq)"
    }
    region bank {
        boundedBy shore
        fill "(0.2sq, 1sq)"
    }
    region pool {
        boundedBy shore
        fill "(1.5sq, 1sq)"
    }
    region shoreBand { within "7dmm" of=shore }
    stack {
        base
        dirt top="6dmm" {
            pin top="[$waterBedHeight .. 6dmm]" at=shoreBand   // anywhere from the bed to the land
            pin top="$waterBedHeight" at=pool   // the bed, written last so it wins
        }
        rock at="(1.314sq, 0.914sq)" size="15dmm"
        water
    }
}
