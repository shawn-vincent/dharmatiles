dharmatiles version="1.0.0"

// Water whose top is a cloud: calm most of the time with rare crests and troughs (a bell over the
// band), on a dirt bank. The waves are one smooth surface whose heights come up as often as the
// bell says; the edge pin keeps the water flush with its neighbours.

tile size="1x1" seed=33 {
    about "A pond whose water top is a cloud: bell(-0.8dmm .. 0.8dmm) about the calm level."

    line shore wobble="5dmm" { through "(0sq, 0.5sq)" "(1sq, 0.5sq)" }
    region pool { boundedBy shore; fill "(0.5sq, 0.8sq)" }
    region shoreBand { within "5dmm" of=shore }

    stack {
        base
        dirt {
            pin top="[$waterBedHeight .. $groundHeight + 1dmm]" at=shoreBand
            pin top="$waterBedHeight" at=pool
        }
        water top="$waterSurfaceHeight + bell(-0.8dmm .. 0.8dmm)"
    }
}
