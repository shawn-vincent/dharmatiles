dharmatiles version="1.0.0"

// A body written inside a definition: the definition's dirt has a top and a pin of its own, and
// the tile calls it by name. Check and build must agree.

define knoll {
    stack {
        dirt top="$groundHeight + 1.5dmm" bumpSize="10dmm" clods=none {
            pin top="$groundHeight + 4dmm" at=center
        }
    }
}

tile size="1x1" seed=6 {
    about "A dirt with a pin inside a definition, called from the stack: check and build both accept it. A test tile."

    stack {
        base
        knoll
    }
}
