dharmatiles version="1.0.0"

// A hill: dirt level well above the edge level, so the ground rises from
// the rim to a broad crown. The golden test for a tall, steep-sided
// ground surface meeting the tile rim.

tile size="2x2" seed=11 {
    about "Dirt raised well above the edge level into a hill, for golden tests."
    stack {
        base
        dirt bumpSize="40dmm" top="[16dmm .. 16dmm + 2dmm]" {
            scatter perSquare=6 { pebble size="1dmm .. 2.2dmm" }
        }
    }
}
