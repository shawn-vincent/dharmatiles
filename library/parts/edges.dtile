dharmatiles version="1.0.0"

// The edge contract: the tops and pins every body of these elements starts
// with, so that neighbouring tiles butt with no step at their edges.  They
// are read before the tile's own lines, so a tile's top replaces the default
// top and its pins win over the default pin wherever they overlap.  The land
// defaults apply to the first land layer only; the water default to every
// water.  A floor, flagstones or planks, is a pieces body: its band is the
// floor height and the edge pin holds it flush with the tile's edge.  A cliff
// is one too: its band is the standard 35dmm over the edge height, a plane its
// stones' tops touch.
defaults {
    dirt  top="[$groundHeight .. $groundHeight + 1dmm]" { pin top="$dirtEdgeHeight" at=edges }
    cliff top="$dirtEdgeHeight + 35dmm"
    flagstones top="$floorHeight"                     { pin top="$floorEdgeHeight" at=edges }
    planks top="$floorHeight"                         { pin top="$floorEdgeHeight" at=edges }
    water top="[$waterSurfaceHeight - 1.9dmm .. $waterSurfaceHeight + 3dmm]" { pin top="$waterEdgeHeight" at=edges }
}
