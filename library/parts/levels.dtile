// The standard levels, in mm at the DungeonBlocks reference (35 mm
// square).  Every tile sees them without a `use` line; a tile's own
// `levels` line adds names or overrides these for that tile only.
//
// The engine keeps each as a fraction of h, the 33.1 mm wall top, so a
// build at another scale moves them with everything else.

levels {
    edge     3.4      // ground meets the tile edge here
    ground   5        // today's grass and soil regions
    water    2.6      // the calm water surface
    wall-top 33.1     // the official wall top
}
