dharmatiles version="1.0.0"

// Creality Ender-3 V3 SE: 220 x 220 x 250 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.
// VERIFY: not yet checked against the maker's own page (see `verify` below).

printer ender-3-v3-se {
    brand   "Creality"
    model   "Ender-3 V3 SE"
    bed     "220x220mm"
    height  "250mm"
    nozzle  "0.4mm"
    slots   1
    verify  "Sources disagree or there is only one: check the bed against the maker's page."
}
