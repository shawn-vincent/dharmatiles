dharmatiles version="1.0.0"

// Creality Ender-3 V2: 220 x 220 x 250 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer ender-3-v2 {
    brand   "Creality"
    model   "Ender-3 V2"
    bed     "220x220mm"
    height  "250mm"
    nozzle  "0.4mm"
    slots   1
}
