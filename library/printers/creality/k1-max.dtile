dharmatiles version="1.0.0"

// Creality K1 Max: 300 x 300 x 300 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer k1-max {
    brand   "Creality"
    model   "K1 Max"
    bed     "300x300mm"
    height  "300mm"
    nozzle  "0.4mm"
    slots   1
}
