dharmatiles version="1.0.0"

// Anycubic Kobra S1: 250 x 250 x 250 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer kobra-s1 {
    brand   "Anycubic"
    model   "Kobra S1"
    bed     "250x250mm"
    height  "250mm"
    nozzle  "0.4mm"
    slots   1
}
