dharmatiles version="1.0.0"

// Elegoo Centauri Carbon 2: 256 x 256 x 256 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer centauri-carbon-2 {
    brand   "Elegoo"
    model   "Centauri Carbon 2"
    bed     "256x256mm"
    height  "256mm"
    nozzle  "0.4mm"
    slots   1
}
