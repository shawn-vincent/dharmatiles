dharmatiles version="1.0.0"

// Prusa Research CORE One L: 300 x 300 x 330 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer core-one-l {
    brand   "Prusa Research"
    model   "CORE One L"
    bed     "300x300mm"
    height  "330mm"
    nozzle  "0.4mm"
    slots   1
}
