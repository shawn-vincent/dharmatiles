dharmatiles version="1.0.0"

// Prusa Research MINI+: 180 x 180 x 180 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer mini-plus {
    brand   "Prusa Research"
    model   "MINI+"
    bed     "180x180mm"
    height  "180mm"
    nozzle  "0.4mm"
    slots   1
}
