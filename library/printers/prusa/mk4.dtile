dharmatiles version="1.0.0"

// Prusa Research MK4 / MK4S: 250 x 210 x 220 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer mk4 {
    brand   "Prusa Research"
    model   "MK4 / MK4S"
    bed     "250x210mm"
    height  "220mm"
    nozzle  "0.4mm"
    slots   1
}
