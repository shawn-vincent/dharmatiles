dharmatiles version="1.0.0"

// Prusa Research CORE One: 250 x 220 x 270 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer core-one {
    brand   "Prusa Research"
    model   "CORE One"
    bed     "250x220mm"
    height  "270mm"
    nozzle  "0.4mm"
    slots   1
}
