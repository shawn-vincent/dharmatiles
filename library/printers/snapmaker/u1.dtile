dharmatiles version="1.0.0"

// Snapmaker U1: 270 x 270 x 270 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer u1 {
    brand   "Snapmaker"
    model   "U1"
    bed     "270x270mm"
    height  "270mm"
    nozzle  "0.4mm"
    slots   4
    // Four toolheads: 4 slots, no purge.
}
