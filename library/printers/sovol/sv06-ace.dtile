dharmatiles version="1.0.0"

// Sovol SV06 ACE: 220 x 220 x 250 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer sv06-ace {
    brand   "Sovol"
    model   "SV06 ACE"
    bed     "220x220mm"
    height  "250mm"
    nozzle  "0.4mm"
    slots   1
}
