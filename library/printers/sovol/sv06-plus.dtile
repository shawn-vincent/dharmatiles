dharmatiles version="1.0.0"

// Sovol SV06 Plus: 300 x 300 x 340 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer sv06-plus {
    brand   "Sovol"
    model   "SV06 Plus"
    bed     "300x300mm"
    height  "340mm"
    nozzle  "0.4mm"
    slots   1
}
