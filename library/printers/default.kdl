// The default printer profile: an FDM printer with a 0.4 mm nozzle.
//
// Looks read this to keep what they build printable.  Every size an
// author writes scales with the system like a photocopy; these numbers
// never do.  They are the hidden printability floors: blade and leaf
// thickness, the least branch radius and print gaps never shrink below
// them, whatever the scale (R6.5).

printer default {
    line     0.45       // one extruded line, mm: the thinnest wall that prints
    layer    0.2        // one layer, mm
    overhang 55         // the steepest overhang that prints, degrees from vertical
    gap      0.2        // the narrowest gap that stays open, mm
}
