dharmatiles version="1.0.0"

// Bambu Lab P2S: 256 x 256 x 256 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer p2s {
    brand   "Bambu Lab"
    model   "P2S"
    bed     "256x256mm"
    height  "256mm"
    nozzle  "0.4mm"
    slots   1
}
