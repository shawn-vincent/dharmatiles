dharmatiles version="1.0.0"

// Bambu Lab P1S: 256 x 256 mm bed; Bambu Studio prints up to 250 mm tall (the maker lists 256),
// and keeps the cutter's front-left corner clear, 18 x 28 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer p1s {
    brand   "Bambu Lab"
    model   "P1S"
    bed     "256x256mm"
    height  "250mm"
    nozzle  "0.4mm"
    slots   1
    excluded {
        zone "(0mm, 0mm) (18mm, 28mm)"  // the filament cutter's corner, kept clear (Bambu Studio's bed_exclude_area)
    }
}
