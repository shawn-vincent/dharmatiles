dharmatiles version="1.0.0"

// Bambu Lab A1: 256 x 256 x 256 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer a1 {
    brand   "Bambu Lab"
    model   "A1"
    bed     "256x256mm"
    height  "256mm"
    nozzle  "0.4mm"
    slots   1
}
