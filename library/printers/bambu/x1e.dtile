dharmatiles version="1.0.0"

// Bambu Lab X1E: 256 x 256 x 256 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.
// VERIFY: the maker lists 256 x 256 x 256 mm; one source (the specification).

printer x1e {
    brand   "Bambu Lab"
    model   "X1E"
    bed     "256x256mm"
    height  "256mm"
    nozzle  "0.4mm"
    slots   1
    verify  "Hand-entered from the maker's published specification; not yet checked against a second source."
}
