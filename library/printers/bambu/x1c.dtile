dharmatiles version="1.0.0"

// Bambu Lab X1 Carbon: 256 x 256 x 256 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer x1c {
    brand   "Bambu Lab"
    model   "X1 Carbon"
    bed     "256x256mm"
    height  "256mm"
    nozzle  "0.4mm"
    slots   1
    // Yours. One filament slot without an AMS.
}
