dharmatiles version="1.0.0"

// Bambu Lab H2D: 350 x 320 x 325 mm.  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.
// VERIFY: not yet checked against the maker's own page (see `verify` below).

printer h2d {
    brand   "Bambu Lab"
    model   "H2D"
    bed     "350x320mm"
    height  "325mm"
    nozzle  "0.4mm"
    slots   1
    verify  "Sources disagree. Single-nozzle area reported near 305 x 320 x 325, dual-nozzle overlap 300 x 320 x 325: the printable area depends on the nozzle mode."
}
