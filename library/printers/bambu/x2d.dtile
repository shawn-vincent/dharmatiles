dharmatiles version="1.0.0"

// Bambu Lab X2D: 256 x 256 x 261 mm, two nozzles (Bambu Studio's machine profile).  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer x2d {
    brand   "Bambu Lab"
    model   "X2D"
    bed     "256x256mm"
    height  "261mm"
    nozzle  "0.4mm"
    slots   2   // one filament a nozzle without an AMS
}
