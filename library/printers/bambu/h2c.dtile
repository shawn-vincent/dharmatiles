dharmatiles version="1.0.0"

// Bambu Lab H2C: 330 x 320 x 325 mm, two nozzles (Bambu Studio's machine profile).  The floors (line, layer, overhang, steepest, gap)
// are the default profile's; a machine names the bed and the filaments.

printer h2c {
    brand   "Bambu Lab"
    model   "H2C"
    bed     "330x320mm"
    height  "325mm"
    nozzle  "0.4mm"
    slots   2   // one filament a nozzle without an AMS
}
