// A line's width: a path across a lawn.  `verge` is a strip 24 mm wide,
// so the grass that follows it covers the strip; `trail` is the same path
// 10 mm wide, and pebbles scatter within half that width either side of it.
tile size="1x1" seed=5 {
    line verge width=24 wobble=3 { through southCenter "0.45,0.5" northCenter }
    line trail width=10 wobble=3 { through southCenter "0.45,0.5" northCenter }
    stack {
        base
        dirt
        grass at=verge
        scatter at=trail perSquare=60 { pebble }
    }
}
