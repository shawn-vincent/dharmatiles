// A drawn shore: the middle point and the fill point are drawn from ranges
// once from the tile seed, so each seed draws its own pond (the contact
// sheet's four seeds show four).
tile size="1x1" seed=8 {
    line shore wobble=3 { through "0,0.4..0.55" "bell(0.35..0.65), 0.4..0.6" "1,0.4..0.55" }
    region pool { boundedBy shore; fill "0.4..0.6,0.1..0.2" }
    region bank { boundedBy shore; fill "0.5,0.9" }
    region shoreBand { within 7 of=shore }
    stack {
        base
        dirt { pin top="[waterBedHeight .. groundHeight + 1]" at=shoreBand; pin top=waterBedHeight at=pool }
        water
        grass at=bank
    }
}
