// The wall page's drystone: a flagstone floor with a fieldstone wall on it.
tile size="1x1" seed=4 {
    about "Drystone flagstones with a fieldstone wall along the north edge."
    stack {
        base
        dirt
        flagstones style=fieldstone
        wall at="north" style=fieldstone coping=on-edge seed=6
    }
}
