// A copy of the library's tiles/ground/1x1-soil, kept as a test tile so the
// library's own can change without touching the tests.
// Bare earth on one square (seed 13).

tile size="1x1" seed=13 {
    about "Bare earth: clods, grit and half-sunk pebbles over gentle rises."
    stack {
        base
        dirt bumpSize=14 top="[groundHeight .. groundHeight + 2.5]" {
   // rises up to 2.5 mm, about 14 mm across
            clods some                  // or: few, many
        }
    }
}
