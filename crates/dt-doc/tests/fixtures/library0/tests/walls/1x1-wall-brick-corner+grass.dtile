// A copy of the library's tiles/walls/1x1-wall-brick-corner, kept as a test tile so the
// library's own can change without touching the tests.
// A worn brick wall turning the north-west corner of a grassy 1×1.

use "parts/grass" lawn

tile size="1x1" seed=66 {
    about "A worn brick wall round the north-west corner, grass to its foot: a test tile."
    stack {
        base
        dirt                                // bare earth at the ground level

        // On a tile edge a wall always stands inside, its outer face
        // flush with the edge.
        wall at="north west" style=brick seed=16 {
            height full                     // up to the wall-top level (33.1 mm)
            thickness 7
        }

        lawn
    }
}
