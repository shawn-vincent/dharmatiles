// The define page's picture: one definition, lawn, called three ways.
use "parts/grass" lawn long-grass

tile size="1x1" seed=6 {
    line a wobble=2 { through "0.33,0" "0.33,1" }
    line b wobble=2 { through "0.67,0" "0.67,1" }
    region west { boundedBy a; fill "0.1,0.5" }
    region middle { boundedBy a b; fill "0.5,0.5" }
    region east { boundedBy b; fill "0.9,0.5" }
    stack {
        base
        dirt
        lawn at=west                                 // its defaults
        lawn at=middle cover="35%" clearings=6       // two params set
        long-grass at=east                           // a definition calling lawn
    }
}
