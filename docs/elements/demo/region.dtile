// The region page's picture: two lines make three regions, each its own
// surface.
tile size="1x1" seed=8 {
    line upper wobble=3 { through "0,0.5" "1,0.56" }
    line lower wobble=4 { through "0,0.2" "1,0.26" }
    region yard { bounded-by upper; fill "0.5,0.85" }
    region bank { bounded-by upper lower; fill "0.5,0.38" }
    region pool { bounded-by lower; fill "0.5,0.1" }
    stack {
        floor in=yard slabs=4
        dirt in=bank
        grass in=bank
        ground in=pool level="water - 2.2"
        water
    }
}
