dharmatiles version="1.0.0"

// The line page's picture: a line through three points, wobbled 5dmm,
// dividing a lawn from bare dirt.  The page shows it beside the same line
// with wobble=0 (cargo xtask pictures makes both).
tile size="1x1" seed=3 {
    line border wobble="5dmm" { through "(0sq, 0.7sq)" "(0.5sq, 0.4sq)" "(1sq, 0.65sq)" }
    region lawn { boundedBy border; fill "(0.5sq, 0.1sq)" }
    stack {
        base
        dirt
        grass at=lawn
    }
}
