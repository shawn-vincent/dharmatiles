// The line page's picture: a line through three points, wobbled 5 mm,
// dividing a lawn from bare dirt.  The page shows it beside the same line
// with wobble=0 (cargo xtask pictures makes both).
tile size="1x1" seed=3 {
    line border wobble=5 { through "0,0.3" "0.5,0.6" "1,0.35" }
    region lawn { bounded-by border; fill "0.5,0.9" }
    stack {
        base
        dirt
        grass in=lawn
    }
}
