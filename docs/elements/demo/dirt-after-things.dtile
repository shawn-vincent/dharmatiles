dharmatiles version="1.0.0"

// The dirt page's picture of dirt listed after things: the stack is built in
// the order it is listed, so the second dirt lies on the tops of the flat
// rocks, banks against the trunk and covers the flowers' feet.
tile size="2x2" seed=5 {
    stack {
        base
        dirt clods=none
        scatter count=9 gap="1.5dmm" {
            tree top="$bottom + [39dmm .. 45dmm]" weight=2 {
                trunk height="16dmm"
                crown width="18dmm" clumps=24 shape=round branching=normal
                leaf length="4.5dmm" width="3dmm"
            }
            rock shape=flat size="4dmm .. 8dmm" weight=2
            flower size="4dmm .. 6dmm" weight=2
        }
        dirt top="$bottom + [0.6dmm .. 1.2dmm]"
    }
}
