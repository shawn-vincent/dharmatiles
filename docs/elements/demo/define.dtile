// The define page's picture: one definition, lawn, called three ways.
use "parts/grass" lawn long-grass

tile calls size="1x1" seed=6 {
    line a wobble=2 { through "0.33,0" "0.33,1" }
    line b wobble=2 { through "0.67,0" "0.67,1" }
    region west { bounded-by a; fill "0.1,0.5" }
    region middle { bounded-by a b; fill "0.5,0.5" }
    region east { bounded-by b; fill "0.9,0.5" }
    stack {
        dirt
        lawn in=west                                 // its defaults
        lawn in=middle cover="35%" clearings=6       // two params set
        long-grass in=east                           // a definition calling lawn
    }
}
